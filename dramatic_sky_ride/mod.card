    { who = "YoDrehDenSwagAuf/overworld-spawn-mod", for_ = "Wilds of Kanto follower and overworld Pokemon ecosystem" },
    { who = "mfrtechconsult/PokePCFollowers", for_ = "maintained Gen 1/2 follower sprite provider and compatibility fork" },
    { who = "absol89/DramaticShapeVoxelMod", for_ = "Battle Art Voxel Fork and voxel camera integration" },
    { who = "artyrambles/DRAMALESS_SHAPE", for_ = "Dramaless Shape voxel provider and public integration surface" },
    { who = "randyadr/3D-Pokemon-Sprites", for_ = "Pokemon Stadium Overworld Models integration target" },
    { who = "DarioMelo/Gen1Recomp-MusicMods", for_ = "optional FRLG/HGSS/LGPE music providers" }
  },
  compat = { engine = ">=0.1.69 <2.0.0", modApi = 2 }
