    { who = "gamecorner-033/PokePCFollowers", for_ = "required Gen 1 overworld Pokemon sprite provider" },
    { who = "ShaneHudson/gen1recomp-mods", for_ = "Wild Skies public integration seams and airborne ecosystem" }
  },
  compat = { engine = ">=0.1.69 <2.0.0", modApi = 2 }
