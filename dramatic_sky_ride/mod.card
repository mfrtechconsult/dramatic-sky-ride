return {
  summary = "Ride Gen 1 Pokemon on land, water and in the air with Battle Art Voxel Fork or Dramaless Shape, required overworld Pokemon sprites, global mount speed controls and strongly recommended Wild Skies encounters.",
  author = "MFR TechConsult",
  tags = { "battle-art-voxel", "dramaless-shape", "flying", "mount", "ground-ride", "surf", "voxel", "wild-skies" },
  differences = {
    changed = {
      "Battle Art Voxel Fork 1.7.6+ or Dramaless Shape 1.6.4+ can provide the voxel runtime DSR integrates with",
      "Battle Art remains preferred automatically if both supported voxel providers are installed",
      "Dramaless uses J for Ground Ride because it reserves G for V-GRID; controller X/Y remain unchanged",
      "global FLIGHT SPEED and GROUND SPEED settings scale all mounts from 50% to 200% while retaining species profiles, boost and gallop",
      "Ground Ride ledge jumps no longer display the temporary JUMP notice",
      "visible Surf activation no longer displays the Visible Surf mount active dialog",
      "PokePC Followers (W/Voxel Support) remains required as the overworld Pokemon/NPC sprite provider",
      "keyboard flight shortcut remains H instead of F to avoid Gen1PC Overworld Encounters' follower-attack binding",
      "Wild Skies 1.4.1+ is strongly recommended and aerial interceptions use a forgiving two-cell envelope",
      "water is ignored only for the voxel 3RD camera boom while surfing, keeping the trainer and Surf mount visible without changing 1ST",
      "large, logically rideable Gen 1 flyers gain a RIDE & FLY party action outdoors",
      "FLY can be required for takeoff and THUNDERBADGE can gate flight like the vanilla field move",
      "SOULBADGE can gate automatic water landings while retaining the existing SURF-user requirement",
      "data-driven field.badgeGates remain enforced across connected-map flight so story progression is not bypassed",
      "canonical vanilla routes/cities must be reached normally before first airborne entry, while unknown custom maps stay open by default",
      "1ST and 3RD use one continuous analog movement solve per frame",
      "looking up/down in 1ST or 3RD can directly raise/lower requested flight altitude",
      "water cells become valid landing spots when progression rules and a party SURF user allow it",
      "landing on water automatically continues in the native surfing state",
      "Ground Ride remembers the preferred mount and restores it safely after battles and party changes",
      "flight altitude and rider rendering survive wild and trainer battles"
    },
    added = {
      "Dramaless Shape 1.6.4+ provider support through its public exports.lib API and st_voxel pipeline",
      "Dramaless Shape 1.6.4 baseline avoids the 1ST/3RD menu softlock and camera-control issues fixed upstream",
      "provider-aware voxel pipeline selection for Battle Art and Dramaless",
      "global Flight and Ground Ride speed controls in the mod options menu",
      "speed scaling for grid/orbit movement, 1ST/3RD FreeMove and connected-map continuity",
      "Battle Art provider-first selection through its public exports.lib API",
      "Battle Art staged-battle lifecycle protection for Ground Ride mount entities",
      "Surf-specific 3RD camera collision compatibility over water",
      "optional but strongly recommended Wild Skies integration through its documented public exports",
      "Wild Skies flyers prefer real species follower/overworld sprites when available",
      "mid-air interception consumes the exact Wild Skies species and level and restores DSR flight after battle",
      "ground wild-battle starts are suppressed while airborne so only explicit air encounters can begin",
      "per-save legitimate-map discovery with optional public opt-in/override helpers for custom integrations",
      "Charizard, Pidgeot, Fearow, Golbat, Aerodactyl, Articuno, Zapdos, Moltres, Dragonair and Dragonite flying mounts",
      "Arcanine, Rapidash, Dodrio, Rhyhorn, Rhydon, Kangaskhan, Tauros and Snorlax Ground Ride mounts",
      "visible Blastoise, Tentacruel, Gyarados and Lapras Surf mounts",
      "Pokedex-proportional visual sizing for all mounts with per-species controls"
    },
    known = {
      "Wild Skies' public takeFlyer result exposes species/level but not flyer altitude, so interception remains cell-radius based",
      "Wild Skies keeps its own dexScale after sprite resolution; DSR intentionally does not patch Wild Skies internals",
      "rider seating still uses procedural offsets rather than dedicated seated sprites",
      "tall-building safety still uses authored zones plus local terrain height"
    }
  },
  credits = {
    { who = "absol89/DramaticShapeVoxelMod", for_ = "Battle Art Voxel Fork, supported voxel provider, cameras and 3D battle presentation" },
    { who = "artyrambles/DRAMALESS_SHAPE", for_ = "Dramaless Shape supported voxel provider and st_voxel integration surface" },
