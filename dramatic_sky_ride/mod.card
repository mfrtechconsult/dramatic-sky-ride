return {
  summary = "Ride Gen 1 Pokemon on land, water and in the air with free voxel controls and native world interactions.",
  author = "MFR TechConsult",
  tags = { "dramatic-shape", "flying", "mount", "ground-ride", "surf", "voxel" },
  differences = {
    changed = {
      "large, logically rideable Gen 1 flyers gain a RIDE & FLY party action outdoors",
      "1ST and 3RD use one continuous analog movement solve per frame",
      "the camera smoothly follows the actual flight course after manual look input stops",
      "water cells become valid landing spots when a party Pokemon knows SURF",
      "landing on water automatically continues in the native surfing state",
      "SURF cannot be started manually while airborne; water landing is the only flight-to-Surf transition",
      "the normal mount shortcut can take off again directly from surfing",
      "Ground Ride remembers the preferred mount and restores it safely after battles and party changes",
      "flight altitude and rider rendering survive wild and trainer battles",
      "ordinary NPC and sign interactions remain available while mounted",
      "incompatible item, machine and field actions dismount before using the native engine path"
    },
    added = {
      "Charizard, Pidgeot, Fearow, Golbat, Aerodactyl, Articuno, Zapdos, Moltres, Dragonair and Dragonite flying mounts",
      "Arcanine, Rapidash, Dodrio, Rhyhorn, Rhydon, Kangaskhan, Tauros and Snorlax Ground Ride mounts",
      "species-aware Ground Ride acceleration, gallop, stamina, dust and rider offsets",
      "optional CAMERA FOLLOW with temporary manual override",
      "manual altitude, landing marker, dynamic shadow, boost, sounds and rumble",
      "visible Blastoise, Tentacruel, Gyarados and Lapras Surf mounts",
      "a central MOUNTS menu for Ground Ride, flight and Surf selection",
      "species-weighted ledge jumps with guarded landings and impact feedback",
      "seamless boost continuity across connected maps in 2D, 1ST and 3RD"
    },
    known = {
      "rider seating still uses procedural offsets rather than dedicated seated sprites",
      "tall-building safety still uses authored zones plus local terrain height",
      "advanced geometry-based roof detection is deferred in the repository backlog",
      "feature development is paused after alpha.15; future work is bug-fix focused"
    }
  },
  credits = {
    { who = "DramaticShape/DramaticShapeVoxelMod", for_ = "voxel scene, first/third-person cameras and continuous free movement" },
    { who = "gamecorner-033/PokePCFollowers", for_ = "Gen 1 follower sprite assets supplied by the user's installation" }
  },
  compat = { engine = ">=0.1.69 <2.0.0", modApi = 2 }
}
