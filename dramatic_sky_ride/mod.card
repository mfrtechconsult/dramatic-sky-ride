return {
  summary = "Ride Gen 1 Pokemon on land, water and in the air with Battle Art Voxel Fork-first support, story-aware FLY progression, discovery safeguards and optional Wild Skies encounters.",
  author = "MFR TechConsult",
  tags = { "battle-art-voxel", "dramatic-shape", "flying", "mount", "ground-ride", "surf", "voxel", "wild-skies" },
  differences = {
    changed = {
      "Battle Art Voxel Fork 1.7.6+ is the primary voxel provider; retired Dramatic Shape remains a legacy fallback",
      "keyboard flight shortcut is H instead of F to avoid Gen1PC Overworld Encounters' follower-attack binding",
      "large, logically rideable Gen 1 flyers gain a RIDE & FLY party action outdoors",
      "FLY can be required for takeoff and THUNDERBADGE can gate flight like the vanilla field move",
      "SOULBADGE can gate automatic water landings while retaining the existing SURF-user requirement",
      "data-driven field.badgeGates remain enforced across connected-map flight so story progression is not bypassed",
      "canonical vanilla routes/cities must be reached normally before first airborne entry, while unknown custom maps stay open by default",
      "1ST and 3RD use one continuous analog movement solve per frame",
      "looking up/down in 1ST or 3RD can directly raise/lower requested flight altitude",
      "the camera smoothly follows the actual flight course after manual look input stops",
      "water cells become valid landing spots when progression rules and a party SURF user allow it",
      "landing on water automatically continues in the native surfing state",
      "SURF cannot be started manually while airborne; water landing is the only flight-to-Surf transition",
      "the normal mount shortcut can take off again directly from surfing",
      "Ground Ride remembers the preferred mount and restores it safely after battles and party changes",
      "flight altitude and rider rendering survive wild and trainer battles",
      "ordinary NPC and sign interactions remain available while mounted",
      "incompatible item, machine and field actions dismount before using the native engine path"
    },
    added = {
      "Battle Art Voxel Fork provider-first selection through its public exports.lib API",
      "optional Wild Skies integration through its documented public exports rather than copied internals",
      "Wild Skies flyers prefer real imported species follower/overworld sprites when available",
      "mid-air interception consumes the exact Wild Skies species and level and restores DSR flight after battle",
      "ground wild-battle starts are suppressed while airborne so only explicit air encounters can begin",
      "Free Fly-shaped isFlying/altitude/mount exports for future hook-based interoperability",
      "per-save legitimate-map discovery with optional public opt-in/override helpers for custom integrations",
      "Charizard, Pidgeot, Fearow, Golbat, Aerodactyl, Articuno, Zapdos, Moltres, Dragonair and Dragonite flying mounts",
      "Arcanine, Rapidash, Dodrio, Rhyhorn, Rhydon, Kangaskhan, Tauros and Snorlax Ground Ride mounts",
      "species-aware Ground Ride acceleration, gallop, stamina, dust and rider offsets",
      "optional CAMERA FOLLOW with temporary manual override",
      "manual altitude, landing marker, dynamic shadow, boost, sounds and rumble",
      "visible Blastoise, Tentacruel, Gyarados and Lapras Surf mounts",
      "a central MOUNTS menu for Ground Ride, flight and Surf selection",
      "species-weighted ledge jumps with guarded landings and impact feedback",
      "seamless boost continuity across connected maps in 2D, 1ST and 3RD",
      "Pokedex-proportional visual sizing for all 22 mounts with per-species controls"
    },
    known = {
      "Wild Skies' public takeFlyer result exposes species/level but not flyer altitude, so interception is cell-radius based",
      "Wild Skies keeps its own dexScale after sprite resolution; DSR intentionally does not patch Wild Skies internals",
      "rider seating still uses procedural offsets rather than dedicated seated sprites",
      "tall-building safety still uses authored zones plus local terrain height",
