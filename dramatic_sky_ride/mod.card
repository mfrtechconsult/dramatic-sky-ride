return {
  summary = "Ride compatible Gen 1 and Gen 2 Pokemon on land, water and in the air, with Gen 2 Open Sky regional soaring and optional 3D terrain.",
  author = "MFR TechConsult",
  tags = { "flying", "mount", "ground-ride", "surf", "open-sky", "2d", "3d", "voxel", "wild-skies", "gen2" },
  differences = {
    changed = {
      "requires Gen1Recomp 0.1.86+ and follows the enforced mod sandbox",
      "cross-mod sprite and voxel integrations use mod.find(...).exports instead of filesystem discovery",
      "direct Crystal 251 DSM cache access is disabled until a sandbox-safe provider bridge exists",
      "direct FRLG/HGSS/LGPE music-folder discovery is disabled under the sandbox",
      "native flat 2D flight no longer requires a voxel provider",
      "Wild Skies keeps its Gen1-compatible >=1.4.1 <2.0.0 dependency range"
    },
    added = {
      "Generation II Open Sky regional soaring over Johto and Kanto",
      "manual ORAS-style Open Sky flight: steer, throttle, brake, boost and altitude control",
      "GLB-derived 3D regional terrain with an HD render pass capped at 1920x1080",
      "absolute stable Open Sky flight altitude independent from terrain relief",
      "illustrated 2D Open Sky fallback with visited Fly Point landing rules",
      "sandbox-safe DSR-owned asset reads through mod:read",
      "public sprite/provider integration surfaces for compatible external mods"
    },
    known = {
      "Open Sky is Generation II only and must be enabled in settings",
      "Open Sky 3D requires a compatible STADIUM2_OVERWORLD_MODELS provider and safely falls back to 2D when unavailable",
